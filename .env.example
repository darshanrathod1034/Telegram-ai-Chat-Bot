# ===========================================
# Telegram Bot Configuration
# ===========================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ===========================================
# AI Provider Configuration
# ===========================================
# NVIDIA OpenAI API (free tier - recommended)
# Get from: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your_nvidia_api_key_here

# Ollama Configuration (optional - fallback)
OLLAMA_MODEL=qwen2.5-coder
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# Server Configuration
# ===========================================
# Your public URL where the server is hosted
# For Render deployment, this will be auto-set
SERVER_URL=https://your-app-name.onrender.com

# Server Port
PORT=3000

# Environment
NODE_ENV=development

# ===========================================
# PostgreSQL Database Configuration
# ===========================================
# For local development, use your local PostgreSQL
# For Render, this will be auto-set from the database add-on
DATABASE_URL=postgresql://username:password@host:5432/database_name

# ===========================================
# Optional Settings
# ===========================================
# Debug mode (set to true for verbose logging)
DEBUG=false
